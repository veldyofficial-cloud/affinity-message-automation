{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infohub-approval-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "ApprovalRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ApprovalRegistry"
      ]
    }
  ],
  "keep_vars": true
}
